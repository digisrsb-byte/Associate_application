# Optional — not used to create default admin passwords (Phase 4 removed that).
# Administrator is created via one-time bootstrap when data/auth.json is missing,
# or already exists from a previous install (existing hashes are preserved).

# Network (Phase 3) — local UAT must stay on loopback
HOST=127.0.0.1
PORT=3000

# Storage directory (Stage 0). Default when unset: <app>/data (live application data).
# E2E / automated tests MUST set both:
#   DATA_DIR=./data-e2e
#   E2E_ISOLATION=1
# Do not point DATA_DIR at the live data folder for tests.
# DATA_DIR=
# E2E_ISOLATION=0
# Do not set HOST=0.0.0.0 for local testing (exposes the app on the LAN).
# For future hosted deployment see HOSTED_DEPLOYMENT_GUIDE.md

# Session cookie Secure flag (Phase 6 / F-02)
# auto (default): Secure=false on loopback HTTP UAT; Secure=true when NODE_ENV=production
# true: always set Secure (HTTPS production / production-like tests)
# false: never set Secure (isolated local HTTP only)
COOKIE_SECURE=auto
# Set TRUST_PROXY=1 only behind a known local reverse proxy. Default off — do not trust arbitrary X-Forwarded-* headers.
# TRUST_PROXY=0

# Required for Phase 2 portal-password encryption (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 32-byte key as base64 OR 64-char hex. Never commit the real key.
PORTAL_PASSWORD_ENCRYPTION_KEY=

# Required for Stage 7C ledger backup encryption (AES-256-GCM). SEPARATE from portal key.
# 32-byte key as base64 OR 64-char hex. Never commit the real key.
# Generate (do not commit): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production — use ONE of:
#   1) BACKUP_ENCRYPTION_KEY via deployment environment / secret manager (preferred); OR
#   2) BACKUP_ENCRYPTION_KEY_FILE to a protected path outside DATA_DIR and DATA_DIR/backups/.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY_FILE=
# Local development / E2E: if unset, the server may default to DATA_DIR/BACKUP_ENCRYPTION_KEY
# (not recommended for production).
# If the backup key is lost, encrypted backups (.json.enc) are permanently unrecoverable.
# Live ledger.json is unaffected. Keep an offline escrow copy of the key.

# Optional: used only by local QA scripts (never by the server runtime)
# QA_EMAIL=admin@srsbassociate.com
# QA_PASSWORD=YourStrongPassword!23

# Phase 1 — local PostgreSQL (JSON remains the live app store until cutover).
# Put the real password in local .env (gitignored). Never commit it.
# Allowed local target: localhost/127.0.0.1 database it_gst_management_dev
DATABASE_URL=
# Required to run: npm run db:migrate (local)
# DB_MIGRATE_CONFIRM=it_gst_management_dev
# Optional read-only: npm run db:preflight
# DB_PREFLIGHT_CONFIRM=it_gst_management_dev
# Required to run: npm run db:rollback (localhost only — no remote rollback in 8B.2)
# DB_ROLLBACK_CONFIRM=it_gst_management_dev
# Phase 2 — ledger JSON → Postgres (app still uses JSON until a later phase)
# DB_IMPORT_CONFIRM=it_gst_management_dev
# DB_VERIFY_CONFIRM=it_gst_management_dev
# Required: explicit frozen ledger copy (NOT live data/ledger.json). Read-only; never modified by scripts.
# LEDGER_IMPORT_PATH=
# Optional organization display name for the single shared org row
# IMPORT_ORG_NAME=IT GST Management

# Phase 8B.2 — remote/managed PostgreSQL (OFF by default). Never set casually.
# DB_TARGET_MODE=local
# Remote migrate/preflight require ALL of:
#   DB_TARGET_MODE=remote
#   DB_APPROVED_REMOTE_HOST=exact.hostname.example
#   DB_APPROVED_REMOTE_DATABASE=exact_db_name   # NOT it_gst_management_dev|test|postgres
#   DB_MIGRATE_CONFIRM=<same exact_db_name>    # migrate only
#   DB_PREFLIGHT_CONFIRM=<same exact_db_name>  # preflight only
#   DB_REMOTE_SSL_MODE=require                 # or sslmode=require|verify-ca|verify-full on URL
# Remote migrate ALSO requires:
#   DB_REMOTE_MIGRATE_ACK=I_UNDERSTAND_THIS_MODIFIES_REMOTE_SCHEMA
#   DB_REMOTE_MIGRATE_TOKEN=MIGRATE_REMOTE_<exact_db_name>
# Never auto-run migrate on application startup. Never use PG_AUTH_TEST_DATABASE_URL for remote.

# Phase 8B.3 — operator two-owner provisioning (CLI only; no HTTP registration).
# Passwords are entered interactively (never CLI args, never logged).
# PROVISION_ORG_NAME=SRSB Associate Shared
# PROVISION_OWNER_A_EMAIL=owner.a@example.com
# PROVISION_OWNER_B_EMAIL=owner.b@example.com
# Local:
#   DB_PROVISION_CONFIRM=it_gst_management_test
#   (uses PG_AUTH_TEST_DATABASE_URL; never falls back to DATABASE_URL for test)
#   or DB_PROVISION_CONFIRM=it_gst_management_dev (uses DATABASE_URL on localhost)
# Remote also requires DB_TARGET_MODE=remote + approved host/db + TLS +
#   DB_REMOTE_PROVISION_ACK=I_UNDERSTAND_THIS_PROVISIONS_OWNERS
#   DB_REMOTE_PROVISION_TOKEN=PROVISION_REMOTE_<exact_db_name>
# npm run db:provision-owners
# Then set AUTH_ORGANIZATION_ID to the printed organization_id (server env — not Git).

# Phase 3 — authentication backend (JSON ledger remains the business SoR).
# AUTH_BACKEND=json          # default — existing auth.json + in-memory sessions
# AUTH_BACKEND=postgres      # PostgreSQL users + sessions (requires DATABASE_URL)
# AUTH_ORGANIZATION_ID=      # shared organization UUID (required when AUTH_BACKEND=postgres)
#
# Dedicated PG auth integration tests only (never production / never auto-fallback):
# PG_AUTH_TEST_CONFIRM=it_gst_management_test
# PG_AUTH_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/it_gst_management_test

# Phase 4 — business data backend (default JSON; no production cutover).
# BUSINESS_DATA_BACKEND=json       # default — existing data/ledger.json behaviour unchanged
# BUSINESS_DATA_BACKEND=postgres   # org-scoped PostgreSQL (requires AUTH_BACKEND=postgres,
#                                  # AUTH_ORGANIZATION_ID, and DATABASE_URL). Fail-closed —
#                                  # never silently falls back to JSON on DB errors.
# JSON ledger backups/restore are refused while BUSINESS_DATA_BACKEND=postgres.
